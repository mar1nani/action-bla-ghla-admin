{
  "manifest_version": 3,
  "name": "Action bla ghla — Import",
  "version": "1.0.0",
  "description": "Permet à ton application Action bla ghla de lire les pages Action avec TON navigateur (le site refuse les serveurs).",
  "icons": { "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["scripting"],
  "host_permissions": ["https://www.action.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.vercel.app/*",
        "https://*.onrender.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
