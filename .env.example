DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ALLOW_LOCAL_STORE_FALLBACK=true
PORT=3000
# Secret de signature des connexions (16+ caractères, à garder identique entre déploiements)
SESSION_SECRET=
# Lecture des captures d'écran par l'IA (catalogue clients)
# Gratuit : clé sur https://aistudio.google.com/apikey (sans carte bancaire)
GEMINI_API_KEY=
# Facultatif : imposer un modèle Gemini (défaut : gemini-flash-latest)
GEMINI_MODEL=
# Option payante, utilisée seulement si GEMINI_API_KEY est vide
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=
