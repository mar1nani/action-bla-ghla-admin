DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ALLOW_LOCAL_STORE_FALLBACK=true
PORT=3000
# Secret de signature des connexions (16+ caractères, à garder identique entre déploiements)
SESSION_SECRET=
# Lecture des captures d'écran par l'IA (catalogue clients)
ANTHROPIC_API_KEY=
# Modèle facultatif (défaut : claude-opus-5-5 ; moins cher : claude-haiku-5-5)
CLAUDE_VISION_MODEL=
